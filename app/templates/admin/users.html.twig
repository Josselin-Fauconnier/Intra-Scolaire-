{% extends 'base.html.twig' %}

{% block title %}Étudiants{% endblock %}

{% block body %}
<turbo-frame id="main-frame">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Étudiants</h2>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <form method="get" action="{{ path('app_admin_users') }}" id="search-form" class="d-flex gap-2 mb-3">
        <input
            type="text"
            name="search"
            value="{{ search }}"
            placeholder="Rechercher un étudiant…"
            class="form-control"
            autocomplete="off"
            id="search-input"
        >
        <select name="promotion" class="form-select" style="width: auto; min-width: 180px;" id="promo-select">
            <option value="">Toutes les promos</option>
            {% for promo in promotions %}
                <option value="{{ promo.id }}" {% if selectedPromotion == promo.id %}selected{% endif %}>
                    {{ promo.name }}
                </option>
            {% endfor %}
        </select>
    </form>

    <div class="list-group">
        {% for student in students %}
            <a href="{{ path('app_students_show', {'id': student.id}) }}"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3"
               data-turbo-frame="main-frame">
                <span class="fw-semibold">{{ student.lastname }} {{ student.firstname }}</span>
                <span class="d-flex gap-1 flex-wrap justify-content-end">
                    {% for pu in student.promotionUsers %}
                        <span class="badge bg-secondary">{{ pu.promotion.name }}</span>
                    {% endfor %}
                </span>
            </a>
        {% else %}
            <div class="list-group-item text-center text-muted py-4">Aucun étudiant trouvé.</div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(students) }}
    </div>

<script>
(function () {
    const input  = document.getElementById('search-input');
    const select = document.getElementById('promo-select');
    const frame  = document.querySelector('turbo-frame#main-frame');
    const base   = '{{ path('app_admin_users') }}';
    let timer;

    if (frame.getAttribute('data-refocus') === 'search') {
        frame.removeAttribute('data-refocus');
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
    }

    function autoSubmit() {
        clearTimeout(timer);
        timer = setTimeout(() => {
            const url = new URL(base, window.location.origin);
            url.searchParams.set('search', input.value);
            url.searchParams.set('promotion', select.value);
            frame.setAttribute('data-refocus', 'search');
            frame.src = url.toString();
        }, 300);
    }

    input.addEventListener('input', autoSubmit);
    select.addEventListener('change', autoSubmit);
})();
</script>

</turbo-frame>
{% endblock %}
