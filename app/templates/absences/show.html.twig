{% extends 'base.html.twig' %}

{% block title %}Detail absence{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detail de l'absence</h2>
        <a href="{{ path('app_absences_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="detail-table-wrapper">
        <table class="table detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ absence.id }}</td>
                </tr>
                <tr>
                    <th>Debut</th>
                    <td>{{ absence.startDate ? absence.startDate|date('d/m/Y H:i') : '—' }}</td>
                </tr>
                <tr>
                    <th>Fin</th>
                    <td>{{ absence.endDate ? absence.endDate|date('d/m/Y H:i') : '—' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_TEACHER') %}
        <div class="detail-actions">
            <a href="{{ path('app_absences_edit', {'id': absence.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
            {{ include('absences/_delete_form.html.twig') }}
        </div>
    {% endif %}
</turbo-frame>
{% endblock %}
