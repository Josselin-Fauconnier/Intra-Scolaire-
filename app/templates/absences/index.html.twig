{% extends 'base.html.twig' %}

{% block title %}Absences index{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Absences</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_absences_new') }}" class="btn btn-success btn-sm">+ Nouvelle absence</a>
        {% endif %}
    </div>

    <div class="responsive-table-wrapper">
        <table class="table table-hover responsive-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Debut</th>
                    <th>Fin</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for absence in absences %}
                <tr>
                    <td data-label="ID">{{ absence.id }}</td>
                    <td data-label="Debut">{{ absence.startDate ? absence.startDate|date('d/m/Y H:i') : '-' }}</td>
                    <td data-label="Fin">{{ absence.endDate ? absence.endDate|date('d/m/Y H:i') : '-' }}</td>
                    <td data-label="Actions">
                        <div class="table-actions">
                            <a href="{{ path('app_absences_show', {'id': absence.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                            {% if is_granted('ROLE_TEACHER') %}
                                <a href="{{ path('app_absences_edit', {'id': absence.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty-row">
                    <td colspan="4" class="table-empty-state">Aucune absence enregistree.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(absences) }}
    </div>
</turbo-frame>
{% endblock %}
