{% extends 'base.html.twig' %}

{% block title %}Absences index{% endblock %}

{% block body %}
    <h1>Absences index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Start_date</th>
                <th>End_date</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for absence in absences %}
            <tr>
                <td>{{ absence.id }}</td>
                <td>{{ absence.startDate ? absence.startDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ absence.endDate ? absence.endDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_absences_show', {'id': absence.id}) }}">show</a>
                    <a href="{{ path('app_absences_edit', {'id': absence.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_absences_new') }}">Create new</a>
{% endblock %}
