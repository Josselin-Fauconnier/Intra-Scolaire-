{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Modifier mon profil</h2>
        <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    {{ form_start(form, {'action': path('app_profile_edit')}) }}
        <div class="mb-3">
            {{ form_label(form.firstname) }}
            {{ form_widget(form.firstname, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.firstname) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.lastname) }}
            {{ form_widget(form.lastname, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.lastname) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.phone_number) }}
            {{ form_widget(form.phone_number, {'attr': {'class': 'form-control', 'placeholder': '+33600000000'}}) }}
            {{ form_errors(form.phone_number) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.github) }}
            {{ form_widget(form.github, {'attr': {'class': 'form-control', 'placeholder': 'https://github.com/...'}}) }}
            {{ form_errors(form.github) }}
        </div>
        <div class="mb-3">
            {{ form_label(form.google_drive) }}
            {{ form_widget(form.google_drive, {'attr': {'class': 'form-control', 'placeholder': 'https://drive.google.com/...'}}) }}
            {{ form_errors(form.google_drive) }}
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
</turbo-frame>
{% endblock %}
