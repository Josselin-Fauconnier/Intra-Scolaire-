{% extends 'base.html.twig' %}

{% block title %}PromotionUsers index{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Membres des promotions</h2>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_promotion_users_new') }}" class="btn btn-success btn-sm">+ Ajouter un membre</a>
        {% endif %}
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Étudiant</th>
                <th>Promotion</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for promotion_user in promotion_users %}
            <tr>
                <td>{{ promotion_user.id }}</td>
                <td>{{ promotion_user.user.firstname }} {{ promotion_user.user.lastname }}</td>
                <td>{{ promotion_user.promotion.name }}</td>
                <td>
                    <a href="{{ path('app_promotion_users_show', {'id': promotion_user.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_promotion_users_edit', {'id': promotion_user.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center text-muted py-4">Aucun étudiant assigné.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</turbo-frame>
{% endblock %}
