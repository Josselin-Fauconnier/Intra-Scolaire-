{# ── Sidebar ── #}
    <nav class="sidebar">
        <div class="sidebar-header">
            <span class="app-name">Intra Scolaire</span>
            <span class="user-name">{{ user.firstname }} {{ user.lastname }}</span>
            <span class="user-role">
                {% if is_granted('ROLE_ADMIN') %}Administrateur
                {% elseif is_granted('ROLE_TEACHER') %}Professeur
                {% elseif is_granted('ROLE_VISITOR') %}Visiteur
                {% else %}Étudiant{% endif %}

            </span>
        </div>

        <ul class="sidebar-nav">
            <li class="nav-section">Navigation</li>

            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_VISITOR') %}
            <li>
                <a href="{{ path('app_promotions_index') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-mortarboard"></i> Promotions
                </a>
            </li>
            {% endif %}
            <li>
                <a href="{{ path('app_absences_index') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-calendar-x"></i> Absences
                </a>
            </li>
            <li>
                <a href="{{ path('app_grades_index') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-clipboard-check"></i>
                    {{ is_granted('ROLE_TEACHER') ? 'À noter' : 'Notes' }}
                </a>
            </li>
            <li>
                <a href="{{ path('app_documents_index') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-file-earmark-text"></i> Documents
                </a>
            </li>
            <li>
                <a href="{{ path('app_projects_index') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-kanban"></i> Projets
                </a>
            </li>
            <li>
                <a href="{{ path('app_notifications_index') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-bell"></i> Notifications
                    {% set unreadCount = unread_notifications_count() %}
                    {% if unreadCount > 0 %}
                        <span class="badge bg-danger ms-auto">{{ unreadCount }}</span>
                    {% endif %}
                </a>
            </li>

            {% if is_granted('ROLE_TEACHER') %}
            <li>
                <a href="{{ path('app_admin_users') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-people-fill"></i> Étudiants
                </a>
            </li>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-section" style="margin-top: 8px;">Administration</li>
            <li>
                <a href="{{ path('app_admin_members') }}"
                   class="sidebar-link"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-people"></i> Membres
                </a>
            </li>
            {% endif %}

            {% if is_granted('ROLE_TEACHER') %}
    <li>
        <a href="{{ path('app_attendance') }}" class="sidebar-link" data-turbo-frame="main-frame">
            <i class="bi bi-people-fill"></i> Emargement
        </a>
    </li>
    {% endif %}

    {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_TEACHER') and not is_granted('ROLE_VISITOR') %}
    <li>
        <a href="{{ path('app_attendance_sign') }}" class="sidebar-link" data-turbo-frame="main-frame">
            <i class="bi bi-pen"></i> Signer ma présence
        </a>
    </li>
    {% endif %}
            
        </ul>

        <div class="sidebar-footer">
            <a href="{{ path('app_profile') }}"
               class="sidebar-link"
               data-turbo-frame="main-frame">
                <i class="bi bi-person-circle"></i> Mon profil
            </a>
            <a href="{{ logout_path() }}">
                <i class="bi bi-box-arrow-left"></i> Déconnexion
            </a>
        </div>
    </nav>