{% extends 'base.html.twig' %}

{% block title %}Dashboard - {{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/index.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="dashboard-layout">
    <nav class="sidebar">
        <div class="sidebar-header">
            <span class="app-name">Intra Scolaire</span>
            <span class="user-name">{{ user.firstname }} {{ user.lastname }}</span>
            <span class="user-role">
                {% if is_granted('ROLE_ADMIN') %}Administrateur
                {% elseif is_granted('ROLE_TEACHER') %}Professeur
                {% else %}Etudiant{% endif %}
            </span>
        </div>

        <ul class="sidebar-nav">
            <li class="nav-section">Navigation</li>

            <li>
                <a href="{{ path('app_promotions_index') }}"
                   class="sidebar-link"
                   aria-label="Promotions"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-mortarboard"></i>
                    <span>Promotions</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_absences_index') }}"
                   class="sidebar-link"
                   aria-label="Absences"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-calendar-x"></i>
                    <span>Absences</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_grades_index') }}"
                   class="sidebar-link"
                   aria-label="Notes"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-clipboard-check"></i>
                    <span>Notes</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_documents_index') }}"
                   class="sidebar-link"
                   aria-label="Documents"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Documents</span>
                </a>
            </li>
            <li>
                <a href="{{ path('app_projects_index') }}"
                   class="sidebar-link"
                   aria-label="Projets"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-kanban"></i>
                    <span>Projets</span>
                </a>
            </li>

            {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-section">Administration</li>
            <li>
                <a href="{{ path('app_promotion_users_index') }}"
                   class="sidebar-link"
                   aria-label="Membres"
                   data-turbo-frame="main-frame">
                    <i class="bi bi-people"></i>
                    <span>Membres</span>
                </a>
            </li>
            {% endif %}
        </ul>

        <div class="sidebar-footer">
            <a href="{{ logout_path() }}" aria-label="Deconnexion">
                <i class="bi bi-box-arrow-left"></i>
            </a>
        </div>
    </nav>

    <main class="main-content">
        <turbo-frame id="main-frame" src="{{ path('app_promotions_index') }}">
            <div class="loading-placeholder">Chargement...</div>
        </turbo-frame>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const links = document.querySelectorAll('.sidebar-link');

        function setActive(link) {
            links.forEach((item) => item.classList.remove('active'));
            link.classList.add('active');
        }

        links.forEach((link) => {
            link.addEventListener('click', function () {
                setActive(this);
            });
        });

        if (links.length > 0) {
            links[0].classList.add('active');
        }
    });
</script>
{% endblock %}
