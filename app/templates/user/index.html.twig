{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <h1>User index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Firstname</th>
                <th>Lastname</th>
                <th>Role</th>
                <th>Phone_number</th>
                <th>Parent_phone_number</th>
                <th>Parent_email</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.firstname }}</td>
                <td>{{ user.lastname }}</td>
                <td>{{ user.role|map(r => r.value)|join(', ') }}</td>
                <td>{{ user.phoneNumber }}</td>
                <td>{{ user.parentPhoneNumber }}</td>
                <td>{{ user.parentEmail }}</td>
                <td>
                    <a href="{{ path('app_user_show', {'id': user.id}) }}">show</a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
                    {% if is_granted('ROLE_ADMIN') and not user.isApproved %}
                        <form method="post" action="{{ path('app_user_approve', {id: user.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ user.id) }}">
                            <button type="submit">Approuver</button>
                        </form>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') and user.isApproved %}
                        <form method="post" action="{{ path('app_user_disable', {id: user.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('disable' ~ user.id) }}">
                            <button type="submit">Désactiver</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_user_new') }}">Create new</a>
{% endblock %}
