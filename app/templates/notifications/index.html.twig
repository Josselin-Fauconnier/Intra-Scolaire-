{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notifications</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_notifications_new') }}" class="btn btn-success btn-sm">+ Nouvelle notification</a>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="dashboard-flash dashboard-flash-success mb-3">{{ message }}</div>
    {% endfor %}

    <div class="responsive-table-wrapper">
        <table class="table table-hover responsive-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Titre</th>
                    <th>Message</th>
                    <th>Lecture</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for recipient in recipients %}
                {% set notif = recipient.notificationId %}
                {% set type = notif.type.value %}
                <tr class="{{ recipient.isRead ? '' : 'dashboard-unread' }}">
                    <td data-label="Type">
                        {% if type == 'alert' %}
                            <span class="badge bg-primary">Alerte</span>
                        {% elseif type == 'warning' %}
                            <span class="badge bg-warning">Avertissement</span>
                        {% elseif type == 'error' %}
                            <span class="badge bg-danger">Erreur</span>
                        {% elseif type == 'success' %}
                            <span class="badge bg-success">Succes</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ type }}</span>
                        {% endif %}
                    </td>
                    <td data-label="Titre">{{ notif.title }}</td>
                    <td data-label="Message">{{ notif.message }}</td>
                    <td data-label="Lecture">
                        <span class="dashboard-read-state">
                            <i class="bi {{ recipient.isRead ? 'bi-check2-circle' : 'bi-bell-fill' }}"></i>
                            {{ recipient.isRead ? 'Lue' : 'Non lue' }}
                        </span>
                    </td>
                    <td data-label="Actions">
                        <div class="table-actions">
                            <a href="{{ path('app_notifications_show', {'id': notif.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                            {% if not recipient.isRead %}
                                <form method="post" action="{{ path('app_notifications_read', {'id': recipient.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('read' ~ recipient.id) }}">
                                    <button class="btn btn-outline-secondary btn-sm">Marquer lue</button>
                                </form>
                            {% endif %}
                            {% if is_granted('ROLE_TEACHER') %}
                                <a href="{{ path('app_notifications_edit', {'id': notif.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty-row">
                    <td colspan="5" class="table-empty-state">Aucune notification.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(recipients) }}
    </div>
</turbo-frame>
{% endblock %}
