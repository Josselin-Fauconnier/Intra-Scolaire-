{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notifications</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_notifications_new') }}" class="btn btn-success btn-sm">+ Nouvelle notification</a>
        {% endif %}
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Type</th>
                <th>Expéditeur</th>
                <th>Titre</th>
                <th>Message</th>
                <th>Lu</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for item in feed %}
            {% set notif     = item.notification %}
            {% set isSent    = item.sent %}
            {% set recipient = item.recipient %}
            {% set isUnread  = (not isSent and recipient and not recipient.isRead) %}

            <tr class="{{ isUnread ? 'fw-bold' : '' }}">
                <td>
                    {% set type = notif.type.value %}
                    {% if type == 'alert' %}<span class="badge bg-primary">Alerte</span>
                    {% elseif type == 'warning' %}<span class="badge bg-warning text-dark">Avertissement</span>
                    {% elseif type == 'error' %}<span class="badge bg-danger">Erreur</span>
                    {% elseif type == 'success' %}<span class="badge bg-success">Succès</span>
                    {% endif %}
                </td>
                <td>
                    {% if isSent %}
                        <em class="text-muted">Vous</em>
                    {% elseif notif.sender %}
                        {{ notif.sender.firstname }} {{ notif.sender.lastname }}
                    {% else %}
                        Système
                    {% endif %}
                </td>
                <td>{{ notif.title }}</td>
                <td>{{ notif.message }}</td>
                <td>
                    {% if isSent %}
                        —
                    {% else %}
                        {{ recipient.isRead ? 'Oui' : 'Non' }}
                    {% endif %}
                </td>
                <td>
                    {% if isUnread %}
                        <form method="post" action="{{ path('app_notifications_read', {'id': recipient.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('read' ~ recipient.id) }}">
                            <button class="btn btn-outline-secondary btn-sm">Marquer lu</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted py-4">Aucune notification.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</turbo-frame>
{% endblock %}
