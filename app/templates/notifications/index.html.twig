{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notifications</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_notifications_new') }}" class="btn btn-success btn-sm">+ Nouvelle notification</a>
        {% endif %}
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Type</th>
                <th>Titre</th>
                <th>Message</th>
                <th>Lu</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for recipient in recipients %}
            {% set notif = recipient.notificationId %}
            <tr class="{{ recipient.isRead ? '' : 'fw-bold' }}">
                <td>
                    {% set type = notif.type.value %}
                    {% if type == 'alert' %}<span class="badge bg-primary">Alerte</span>
                    {% elseif type == 'warning' %}<span class="badge bg-warning text-dark">Avertissement</span>
                    {% elseif type == 'error' %}<span class="badge bg-danger">Erreur</span>
                    {% elseif type == 'success' %}<span class="badge bg-success">Succès</span>
                    {% endif %}
                </td>
                <td>{{ notif.title }}</td>
                <td>{{ notif.message }}</td>
                <td>{{ recipient.isRead ? 'Oui' : 'Non' }}</td>
                <td>
                    {% if not recipient.isRead %}
                        <form method="post" action="{{ path('app_notifications_read', {'id': recipient.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('read' ~ recipient.id) }}">
                            <button class="btn btn-outline-secondary btn-sm">Marquer lu</button>
                        </form>
                    {% endif %}
                    {% if is_granted('ROLE_TEACHER') %}
                        <a href="{{ path('app_notifications_edit', {'id': notif.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">Aucune notification.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(recipients) }}
    </div>
</turbo-frame>
{% endblock %}
