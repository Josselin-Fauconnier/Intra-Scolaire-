{% extends 'base.html.twig' %}

{% block title %}Modifier le Document{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            {# Lien de retour stylisé #}
            <div class="mb-3">
                <a href="{{ path('app_documents_index') }}" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h1 class="h4 mb-0">Modifier le document : {{ document.title }}</h1>
                </div>
                
                <div class="card-body p-4">
                    {# Inclusion du formulaire de base #}
                    <div class="main-form mb-4">
                        {{ include('documents/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
                    </div>

                    <hr class="my-4">

                    {# Zone d'actions critiques (Suppression) #}
                    
                        <span class="text-muted small">Supprimer le document:</span>
                        {{ include('documents/_delete_form.html.twig') }} 
                   
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Structure globale */
    body { background-color: #f8f9fa; }
    
    .card { border-radius: 12px; }
    .card-header { border-radius: 12px 12px 0 0 !important; }

    /* Aligner le bouton supprimer sur la même ligne que le label danger */
    .form-actions-row {
        display: flex;
        justify-content: space-between; /* Pousse le bouton supprimer à droite */
        align-items: center;
        padding: 15px;
        background-color: #fff5f5; /* Fond rouge très léger */
        border: 1px dashed #feb2b2;
        border-radius: 8px;
    }

    /* Style pour les formulaires imbriqués */
    form { display: inline; margin: 0; }

    /* Amélioration des inputs (si non géré par bootstrap) */
    .main-form input, .main-form select {
        margin-bottom: 15px;
    }

    /* Personnalisation du bouton Update de Symfony (par défaut souvent .btn-primary) */
    .btn-primary {
        background-color: #0d6efd;
        border: none;
        padding: 10px 25px;
        font-weight: 600;
        border-radius: 6px;
    }
</style>
{% endblock %}