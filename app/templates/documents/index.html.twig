{% extends 'base.html.twig' %}

{% block title %}Gestion des documents{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-journal-bookmark-fill"></i> Documents</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_documents_new') }}" class="btn btn-success btn-sm">
                <i class="bi bi-plus-lg"></i> Ajouter un document
            </a>
        {% endif %}
    </div>

    <div class="responsive-table-wrapper">
        <table class="table table-hover responsive-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Titre</th>
                    <th>Fichier</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for document in documents %}
                {% set type_value = document.type.value|default('autre')|lower %}
                <tr>
                    <td data-label="ID">#{{ document.id }}</td>
                    <td data-label="Type">
                        <span class="type-tag {{ type_value == 'pdf' ? 'type-pdf' : (type_value == 'video' ? 'type-video' : 'type-other') }}">
                            {{ type_value }}
                        </span>
                    </td>
                    <td data-label="Titre" class="fw-bold">{{ document.title }}</td>
                    <td data-label="Fichier"><code class="small text-muted">{{ document.path|default('-') }}</code></td>
                    <td data-label="Actions">
                        <div class="table-actions">
                            <a href="{{ path('app_documents_show', {'id': document.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                            {% if document.path %}
                                <a href="{{ asset('uploads/documents/' ~ document.path) }}"
                                   class="btn btn-outline-primary btn-sm"
                                   download="{{ document.title }}">
                                    <i class="bi bi-download"></i> Telecharger
                                </a>
                            {% endif %}
                            {% if is_granted('ROLE_TEACHER') %}
                                <a href="{{ path('app_documents_edit', {'id': document.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty-row">
                    <td colspan="5" class="table-empty-state">Aucun document enregistre.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(documents) }}
    </div>
</turbo-frame>
{% endblock %}
