{% extends 'base.html.twig' %}

{% block title %}Detail document{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detail du document</h2>
        <a href="{{ path('app_documents_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="detail-table-wrapper">
        <table class="table detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>#{{ document.id }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>
                        {% set typeValue = document.type.value|lower %}
                        <span class="type-tag {{ typeValue == 'pdf' ? 'type-pdf' : (typeValue == 'video' ? 'type-video' : 'type-other') }}">
                            {{ typeValue|upper }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <th>Titre</th>
                    <td class="fw-bold">{{ document.title }}</td>
                </tr>
                <tr>
                    <th>Fichier</th>
                    <td><code class="text-muted">{{ document.path }}</code></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="detail-actions">
        {% if document.path %}
            <a href="{{ asset('uploads/documents/' ~ document.path) }}"
               class="btn btn-outline-primary btn-sm"
               download="{{ document.title }}">
                <i class="bi bi-download"></i> Telecharger
            </a>
        {% endif %}
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_documents_edit', {'id': document.id}) }}" class="btn btn-warning btn-sm">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            {{ include('documents/_delete_form.html.twig') }}
        {% endif %}
    </div>
</turbo-frame>
{% endblock %}
