{% extends 'base.html.twig' %}

{% block title %}Signature de présence{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Feuille de présence</h2>
        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    {% if errorMessage is defined %}
        <div class="alert alert-warning">{{ errorMessage }}</div>
    {% endif %}

    {% if infoMessage is defined %}
        <div class="alert alert-info">{{ infoMessage }}</div>
    {% endif %}

    {% if form is defined and form is not empty %}
        {{ form_start(form, {'action': path('app_attendance_sign'), 'attr': {'novalidate': 'novalidate', 'class': 'dashboard-form', 'data-turbo': 'false'}}) }}
            <div class="dashboard-form-shell dashboard-form-shell-compact">
                <div class="dashboard-form-intro">
                    <span class="pill">Signature</span>
                    <p class="dashboard-note">Choisissez votre présence ou votre absence, puis envoyez votre demande au professeur.</p>
                </div>

                {% if form_errors(form) %}
                    <div class="dashboard-flash dashboard-flash-danger mb-3">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}

                <div class="dashboard-form-fields">
                    <div>
                        {{ form_label(form.status) }}
                        <div class="dashboard-form-status">
                            {% for choice in form.status %}
                                <div class="form-check">
                                    {{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_label(choice, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                </div>
                            {% endfor %}
                            {{ form_errors(form.status) }}
                        </div>
                    </div>
                    <div>
                        {{ form_label(form.comment) }}
                        {{ form_widget(form.comment, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                        {{ form_errors(form.comment) }}
                    </div>
                </div>

                <div class="dashboard-form-actions mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-pen"></i> Envoyer ma demande
                    </button>
                    <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </div>
        {{ form_end(form) }}
    {% endif %}
</turbo-frame>
{% endblock %}