{% extends 'base.html.twig' %}

{% block body %}
<turbo-frame id="main-frame">
    <h2>Appel : {{ promotion.name }}</h2>

    {# On ajoute l'action explicitement #}
    <form action="{{ path('app_attendance_sheet', {id: promotion.id}) }}" method="post">
        <table class="table">
            <thead>
                <tr>
                    <th>Étudiant</th>
                    <th>Présent</th>
                    <th>En retard</th>
                    <th>Absent</th>
                </tr>
            </thead>        
            <tbody>
                {% for student in students %}
                    <tr>
                        <td>{{ student.firstname|capitalize }} {{ student.lastname|upper }}</td>
                        <td><input type="radio" name="attendance[{{ student.id }}]" value="present" checked></td>
                        <td><input type="radio" name="attendance[{{ student.id }}]" value="late"></td>
                        <td><input type="radio" name="attendance[{{ student.id }}]" value="absent"></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Valider l'appel</button>
            <a href="{{ path('app_admin_users') }}" class="btn btn-secondary" data-turbo-frame="_top">Retour</a>
        </div>
    </form>
</turbo-frame>
{% endblock %}