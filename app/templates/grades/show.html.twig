{% extends 'base.html.twig' %}

{% block title %}Détail note{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Détail de la note</h2>
        <a href="{{ path('app_grades_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <table class="table">
        <tbody>
            <tr><th>ID</th><td>{{ grade.id }}</td></tr>
            <tr><th>Note</th><td>{{ grade.grade }}</td></tr>
            <tr><th>Commentaire</th><td>{{ grade.comments }}</td></tr>
            <tr><th>Soumission</th><td>{{ grade.submission }}</td></tr>
            <tr><th>Mise à jour</th><td>{{ grade.updateHistory ? grade.updateHistory|date('d/m/Y H:i') : '—' }}</td></tr>
            <tr><th>Statut</th><td>{{ grade.status }}</td></tr>
        </tbody>
    </table>

    {% if is_granted('ROLE_TEACHER') %}
        <a href="{{ path('app_grades_edit', {'id': grade.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
        {{ include('grades/_delete_form.html.twig') }}
    {% endif %}
</turbo-frame>
{% endblock %}
