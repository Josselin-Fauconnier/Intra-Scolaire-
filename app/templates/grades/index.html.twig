{% extends 'base.html.twig' %}

{% block title %}Grades index{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notes</h2>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Promotion</th>
                <th>Projet</th>
                <th>Note</th>
                <th>Commentaire</th>
                <th>Soumission</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for grade in grades %}
            <tr>
                <td>{{ grade.promotion.name }}</td>
                <td>{{ grade.project.title }}</td>
                <td>{{ grade.grade }}</td>
                <td>{{ grade.comments }}</td>
                <td>{{ grade.submission }}</td>
                <td>{{ grade.updateHistory ? grade.updateHistory|date('d/m/Y H:i') : '—' }}</td>
                <td>{{ grade.status.value }}</td>
                <td>
                    <a href="{{ path('app_grades_show', {'id': grade.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Aucune note enregistrée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(grades) }}
    </div>
</turbo-frame>
{% endblock %}
