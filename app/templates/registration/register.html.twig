{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}


{% block body %}
<div class="register-wrapper">
    <div>
        <h1 class="register-title">Inscription</h1>
        <div class="register-card">

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
                {{ form_row(registrationForm.email, { attr: { placeholder: 'Entrez votre email' } }) }}
                {{ form_row(registrationForm.firstname, { attr: { placeholder: 'Entrez votre prénom' } }) }}
                {{ form_row(registrationForm.lastname, { attr: { placeholder: 'Entrez votre nom' } }) }}
                {{ form_row(registrationForm.role) }}
                {{ form_row(registrationForm.phone_number, { attr: { placeholder: 'Numéro de téléphone' } }) }}

                <div id="parent-fields" style="display: none;">
                    {{ form_row(registrationForm.parent_phone_number, { attr: { placeholder: 'Téléphone du parent' } }) }}
                    {{ form_row(registrationForm.parent_email, { attr: { placeholder: 'Email du parent' } }) }}
                </div>

                {{ form_row(registrationForm.plainPassword, {
                    label: 'Mot de passe',
                    attr: { placeholder: 'Entrez votre mot de passe' }
                }) }}
                {{ form_row(registrationForm.agreeTerms) }}

                <button type="submit">S'inscrire</button>
            {{ form_end(registrationForm) }}

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const roleCheckboxes = document.querySelectorAll('input[type="checkbox"][id*="role"]');
                    const parentFields = document.getElementById('parent-fields');

                    function update(changed) {
                        roleCheckboxes.forEach(cb => {
                            if (cb !== changed) cb.checked = false;
                        });

                        const isStudent = changed.checked && changed.value === 'ROLE_STUDENT';
                        parentFields.style.display = isStudent ? 'block' : 'none';

                        if (!isStudent) {
                            parentFields.querySelectorAll('input').forEach(i => i.value = '');
                        }
                    }

                    roleCheckboxes.forEach(cb => cb.addEventListener('change', () => update(cb)));
                });
            </script>

        </div>
        <p style="text-align: center; margin-top: 1rem; font-weight: 600; color: #1a3a5c;">
            Déjà un compte ? <a href="{{ path('app_login') }}" style="color: #1a3a5c;">Se connecter</a>
        </p>
    </div>
</div>
{% endblock %}
