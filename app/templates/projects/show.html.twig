{% extends 'base.html.twig' %}

{% block title %}Detail projet{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detail du projet</h2>
        <a href="{{ path('app_projects_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="detail-table-wrapper">
        <table class="table detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ project.id }}</td>
                </tr>
                <tr>
                    <th>Titre</th>
                    <td>{{ project.title }}</td>
                </tr>
                <tr>
                    <th>Visibilite</th>
                    <td>{{ project.visibility ? 'Public' : 'Prive' }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ project.description }}</td>
                </tr>
                <tr>
                    <th>Google Drive</th>
                    <td>{% if project.googleDrive %}<a href="{{ project.googleDrive }}" target="_blank">Lien</a>{% else %}—{% endif %}</td>
                </tr>
                <tr>
                    <th>Date limite</th>
                    <td>{{ project.dueDate ? project.dueDate|date('d/m/Y') : '—' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_TEACHER') %}
        <div class="detail-actions">
            <a href="{{ path('app_projects_edit', {'id': project.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
            {{ include('projects/_delete_form.html.twig') }}
        </div>
    {% endif %}
</turbo-frame>
{% endblock %}
