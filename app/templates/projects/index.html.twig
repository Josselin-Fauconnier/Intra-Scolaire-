{% extends 'base.html.twig' %}

{% block title %}Projects index{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Projets</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_projects_new') }}" class="btn btn-success btn-sm">+ Nouveau projet</a>
        {% endif %}
    </div>

    <div class="responsive-table-wrapper">
        <table class="table table-hover responsive-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Visibilite</th>
                    <th>Description</th>
                    <th>Google Drive</th>
                    <th>Date limite</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for project in projects %}
                <tr>
                    <td data-label="ID">{{ project.id }}</td>
                    <td data-label="Titre">{{ project.title }}</td>
                    <td data-label="Visibilite">{{ project.visibility ? 'Public' : 'Prive' }}</td>
                    <td data-label="Description">{{ project.description }}</td>
                    <td data-label="Google Drive">
                        {% if project.googleDrive %}
                            <a href="{{ project.googleDrive }}" target="_blank">Lien</a>
                        {% else %}-{% endif %}
                    </td>
                    <td data-label="Date limite">{{ project.dueDate ? project.dueDate|date('d/m/Y') : '-' }}</td>
                    <td data-label="Actions">
                        <div class="table-actions">
                            <a href="{{ path('app_projects_show', {'id': project.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                            {% if is_granted('ROLE_TEACHER') %}
                                <a href="{{ path('app_projects_edit', {'id': project.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty-row">
                    <td colspan="7" class="table-empty-state">Aucun projet enregistre.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(projects) }}
    </div>
</turbo-frame>
{% endblock %}
