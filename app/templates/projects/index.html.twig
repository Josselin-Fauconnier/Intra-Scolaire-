{% extends 'base.html.twig' %}

{% block title %}Projects index{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Projets</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_projects_new') }}" class="btn btn-success btn-sm">+ Nouveau projet</a>
        {% endif %}
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Promotion</th>
                <th>Titre</th>
                <th>Visibilité</th>
                <th>Description</th>
                <th>Google Drive</th>
                <th>Date limite</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.id }}</td>
                <td>{{ project.promotion.name }}</td>
                <td>{{ project.title }}</td>
                <td>{{ project.visibility ? 'Public' : 'Privé' }}</td>
                <td>{{ project.description }}</td>
                <td>
                    {% if project.googleDrive %}
                        <a href="{{ project.googleDrive }}" target="_blank">Lien</a>
                    {% else %}—{% endif %}
                </td>
                <td>{{ project.dueDate ? project.dueDate|date('d/m/Y') : '—' }}</td>
                <td>
                    <a href="{{ path('app_projects_show', {'id': project.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                    {% if is_granted('ROLE_TEACHER') %}
                        <a href="{{ path('app_projects_edit', {'id': project.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Aucun projet enregistré.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</turbo-frame>
{% endblock %}
