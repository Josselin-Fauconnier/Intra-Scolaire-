{% extends 'base.html.twig' %}

{% block title %}Promotions index{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Promotions</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_promotions_new') }}" class="btn btn-success btn-sm">+ Nouvelle promotion</a>
        {% endif %}
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Professeur</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for promotion in promotions %}
            <tr>
                <td>{{ promotion.id }}</td>
                <td>{{ promotion.name }}</td>
                <td>{{ promotion.professor.firstname }} {{ promotion.professor.lastname }}</td>
                <td>
                    <a href="{{ path('app_promotions_show', {'id': promotion.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                    {% if is_granted('ROLE_TEACHER') %}
                        <a href="{{ path('app_promotions_edit', {'id': promotion.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center text-muted py-4">Aucune promotion enregistrée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(promotions) }}
    </div>
</turbo-frame>
{% endblock %}
