{% extends 'base.html.twig' %}

{% block title %}Détail promotion{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Détail de la promotion</h2>
        <a href="{{ path('app_promotions_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <table class="table">
        <tbody>
            <tr><th>ID</th><td>{{ promotion.id }}</td></tr>
            <tr><th>Nom</th><td>{{ promotion.name }}</td></tr>
        </tbody>
    </table>

    <ul>
    {% for project in promotion.projects %}
        <li>
            <a href="{{ path('app_projects_show', {'id': project.id}) }}">
                {{ project.title }}
            </a>
        </li>
    {% else %}
        <li>Aucun projet</li>
    {% endfor %}
    </ul>

    {% if is_granted('ROLE_TEACHER') %}
        <a href="{{ path('app_promotions_edit', {'id': promotion.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
        {{ include('promotions/_delete_form.html.twig') }}
    {% endif %}
</turbo-frame>
{% endblock %}
