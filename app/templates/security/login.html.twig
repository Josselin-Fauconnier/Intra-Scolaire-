{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
<style>
    .login-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem 1rem;
    }
    .login-title {
        text-align: center;
        font-size: 1.8rem;
        font-weight: 700;
        color: #1a3a5c;
        margin-bottom: 1.25rem;
    }
    .login-card {
        background-color: #1a3a5c !important;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 420px;
    }
    .login-card label {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 500;
        color: #ffffff;
    }
    .login-card input {
        width: 100%;
        padding: 0.6rem 0.75rem;
        margin-bottom: 1rem;
        border: 1px solid #5a80a8;
        border-radius: 6px;
        font-size: 1rem;
        box-sizing: border-box;
        background-color: #ffffff;
        color: #1a3a5c;
    }
    .login-card button {
        width: 100%;
        padding: 0.75rem;
        background-color: #f5efe0;
        color: #1a3a5c;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        margin-top: 0.5rem;
    }
    .login-card button:hover {
        background-color: #e8dcc8;
    }
    .alert-danger {
        background-color: #fde8e8;
        color: #a00;
        border: 1px solid #f5c6c6;
        border-radius: 6px;
        padding: 0.6rem 0.75rem;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div>
        <h1 class="login-title">Connexion</h1>
        <div class="login-card">

        {% if error %}
            <div class="alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div style="margin-bottom: 1rem; font-size: 0.9rem;">
                Connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Se déconnecter</a>
            </div>
        {% endif %}

        <form method="post">
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" placeholder="Entrez votre email" required autofocus>

            <label for="password">Mot de passe</label>
            <input type="password" name="_password" id="password" autocomplete="current-password" placeholder="Entrez votre mot de passe" required>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>
        </form>
        </div>
        <p style="text-align: center; margin-top: 1rem; font-weight: 600; color: #1a3a5c;">
            Mot de passe oublié ? 
        </p>
    </div>
</div>
{% endblock %}
